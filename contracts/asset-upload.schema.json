{
  "$id": "https://zirbel.app/contracts/asset-upload.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "source": {
      "type": "string",
      "pattern": "^https?:\\/\\/",
      "x-zirbel-prepare": "url"
    },
    "license": {
      "type": "string",
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "MIT",
        "local-only",
        "unknown"
      ]
    },
    "credit": {
      "type": "string",
      "maxLength": 600
    },
    "media": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    },
    "data": {
      "type": "string",
      "maxLength": 7000000
    },
    "branch": {
      "default": "main",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "baseRevision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    }
  },
  "required": [
    "name",
    "author",
    "source",
    "license",
    "credit",
    "media",
    "data",
    "baseRevision"
  ],
  "additionalProperties": false
}
