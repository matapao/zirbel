{
  "$id": "https://zirbel.app/contracts/server-message.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
        },
        "seat": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            },
            "role": {
              "type": "string",
              "enum": [
                "player",
                "spectator"
              ]
            },
            "connected": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name",
            "role",
            "connected"
          ],
          "additionalProperties": false
        },
        "resume": {
          "type": "string"
        },
        "ack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "version",
        "releaseId",
        "seat",
        "resume",
        "ack"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "snapshot"
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "role": {
                "type": "string",
                "enum": [
                  "player",
                  "spectator"
                ]
              },
              "connected": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "connected"
            ],
            "additionalProperties": false
          }
        },
        "state": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "type",
        "tick",
        "ack",
        "seats",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "protocol",
            "expired",
            "full",
            "forbidden",
            "invalid-action",
            "stale-action",
            "closed"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "closed"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
