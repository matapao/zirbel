{
  "$id": "https://zirbel.app/contracts/import-git.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
    }
  },
  "required": [
    "url"
  ],
  "additionalProperties": false
}
