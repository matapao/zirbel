{
  "$id": "https://zirbel.app/contracts/client-message.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "credential": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{20,100}$"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
        }
      },
      "required": [
        "type",
        "version",
        "credential",
        "releaseId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "action"
        },
        "sequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147483647
        },
        "action": {}
      },
      "required": [
        "type",
        "sequence",
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resync"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "leave"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
