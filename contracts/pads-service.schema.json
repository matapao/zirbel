{
  "$id": "https://zirbel.app/contracts/pads-service.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "device"
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "standard": {
          "type": "boolean"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "device",
        "name",
        "standard"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gone"
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      },
      "required": [
        "type",
        "device"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "controllers"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {}
    }
  ]
}
