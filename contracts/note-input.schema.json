{
  "$id": "https://zirbel.app/contracts/note-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "x-zirbel-prepare": "trim"
    },
    "branch": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "references": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "instance"
              },
              "sceneId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
              },
              "object": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "tree",
                      "rock",
                      "crystal",
                      "campfire",
                      "cabin",
                      "water",
                      "bridge",
                      "spawn",
                      "placeholder",
                      "npc",
                      "enemy"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "x-zirbel-prepare": "trim"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 960
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 600
                  },
                  "size": {
                    "type": "number",
                    "minimum": 8,
                    "maximum": 340
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[a-fA-F0-9]{6}$"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "health": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "power": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "requires": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "name",
                  "x",
                  "y",
                  "size",
                  "color"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "sceneId",
              "revision",
              "object"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "region"
              },
              "sceneId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
              },
              "bounds": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 960
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 600
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 960
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 600
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "objects": {
                "maxItems": 160,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "tree",
                        "rock",
                        "crystal",
                        "campfire",
                        "cabin",
                        "water",
                        "bridge",
                        "spawn",
                        "placeholder",
                        "npc",
                        "enemy"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "x-zirbel-prepare": "trim"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 960
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600
                    },
                    "size": {
                      "type": "number",
                      "minimum": 8,
                      "maximum": 340
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[a-fA-F0-9]{6}$"
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "health": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "power": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "requires": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "name",
                    "x",
                    "y",
                    "size",
                    "color"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "sceneId",
              "revision",
              "bounds",
              "objects"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "attachments": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "creator",
        "assistant"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "designPrompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000,
      "x-zirbel-prepare": "trim"
    }
  },
  "required": [
    "text",
    "branch",
    "references",
    "attachments"
  ],
  "additionalProperties": false
}
