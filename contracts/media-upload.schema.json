{
  "$id": "https://zirbel.app/contracts/media-upload.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "intent": {
      "type": "string",
      "enum": [
        "Inspiration",
        "Material to copy",
        "Text to transcribe",
        "Motion to study",
        "Asset to place"
      ]
    },
    "media": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "video/mp4",
        "video/webm",
        "text/plain"
      ]
    },
    "transcript": {
      "type": "string",
      "maxLength": 4000
    },
    "original": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "data": {
      "type": "string",
      "maxLength": 24000000
    }
  },
  "required": [
    "name",
    "intent",
    "media",
    "transcript",
    "data"
  ],
  "additionalProperties": false
}
