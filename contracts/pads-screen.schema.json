{
  "$id": "https://zirbel.app/contracts/pads-screen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "claim"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "release"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "required": [
        "type",
        "slot"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rumble"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "strong": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weak": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "slot",
        "duration",
        "strong",
        "weak"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "show"
        },
        "link": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^\\/join\\/[a-z0-9]{1,64}(?:#[A-Za-z0-9_=-]{1,128})?$"
        }
      },
      "required": [
        "type",
        "link"
      ],
      "additionalProperties": false
    }
  ]
}
