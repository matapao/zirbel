{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "packages/server/cli.ts",
        "packages/web/{workspace,player,game-sdk,garden-3d}.ts",
        "packages/net/{index,internal}.ts",
        "test/*.{ts,mjs}"
      ],
      "ignore": ["deps/**"],
      "project": [
        "packages/**/*.ts",
        "scripts/**/*.mjs",
        "test/**/*.{ts,mjs}"
      ],
      "ignoreDependencies": [
        "@openai/codex-sdk"
      ],
      "ignoreBinaries": [
        "go",
        "mkfifo",
        "rundll32.exe",
        "xdg-open"
      ]
    },
    "desktop": {
      "entry": ["test/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs"],
      "ignoreBinaries": ["sips"]
    }
  }
}
