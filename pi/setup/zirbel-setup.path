# Starts the Wi-Fi setup when the editor asks to change the Wi-Fi: it leaves /run/zirbel-setup/request, which the setup
# removes when it is over.
[Unit]
Description=Zirbel box Wi-Fi setup, when the editor asks for it

[Path]
PathExists=/run/zirbel-setup/request
Unit=zirbel-setup.service

[Install]
WantedBy=paths.target
