# Once cloud-init has applied the Wi-Fi that pi/write-card.sh put on the boot partition, its password leaves that
# partition, which anyone holding the card can read: it is kept for root alone in /var/lib/zirbel/first-boot.
[Unit]
Description=Zirbel box: the first boot's Wi-Fi password off the boot partition
After=cloud-final.service
ConditionPathExists=/boot/firmware/network-config

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'grep -q "^ *wifis:" /boot/firmware/network-config || exit 0; install -d -m 700 /var/lib/zirbel/first-boot; mv /boot/firmware/network-config /var/lib/zirbel/first-boot/network-config; chmod 600 /var/lib/zirbel/first-boot/network-config; printf "# Applied on the first boot; kept in /var/lib/zirbel/first-boot.\\n" > /boot/firmware/network-config'

[Install]
WantedBy=multi-user.target
