# The Zirbel host (Go) on a 32-bit Zirbel box, where the Node editor and the harnesses don't run: the editor API and
# MCP on every network address at port 80, for paired devices only (--box), as the `zirbel` user, whose home keeps the
# games. People bring their own agent, over MCP. The box's controller service brings its gamepads to /run/zirbel-pads.
[Unit]
Description=Zirbel host
Wants=network-online.target
After=network-online.target

[Service]
User=zirbel
Group=zirbel
WorkingDirectory=/home/zirbel
ExecStart=/opt/zirbel/zirbel-host --box --port 80 --pads-socket /run/zirbel-pads/host.sock
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# Its home, the setup service's requests, and the folder of its local socket for the box's controllers (pi/controllers).
ReadWritePaths=/home/zirbel -/run/zirbel-setup -/run/zirbel-pads
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
