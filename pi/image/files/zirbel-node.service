# The Zirbel editor (Node) on a 64-bit Zirbel box: on every network address at port 80, for paired devices only (--box), as the
# `zirbel` user, whose home keeps the games, the harness sign-ins and the threads' folders.
[Unit]
Description=Zirbel editor
Wants=network-online.target
After=network-online.target

[Service]
User=zirbel
Group=zirbel
WorkingDirectory=/home/zirbel
Environment=PATH=/home/zirbel/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ZIRBEL_BROWSER=/usr/bin/chromium
ExecStart=/usr/local/bin/node /opt/zirbel/server.mjs --box --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=full
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
