# The Zirbel box's controllers: every gamepad, joystick and wheel on the box, USB or Bluetooth, to the host over its local
# socket in /run/zirbel-pads, and Bluetooth pairing for Box settings. As its own user, zirbel-pads (groups input for
# /dev/input, bluetooth for BlueZ, zirbel-pads for the host's socket), never root, and with no network of its own: D-Bus
# and the host's socket are files.
[Unit]
Description=Zirbel box controllers
After=bluetooth.service systemd-tmpfiles-setup.service
Wants=bluetooth.service

[Service]
User=zirbel-pads
Group=zirbel-pads
ExecStart=/usr/bin/python3 -E -s /opt/zirbel/pi/controllers/zirbel_pads.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# The input devices alone, read and written (rumble).
DevicePolicy=closed
DeviceAllow=char-input rw
MemoryMax=64M

[Install]
WantedBy=multi-user.target
