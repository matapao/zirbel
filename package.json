{
  "name": "zirbel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "contracts": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/contracts.ts",
    "check": "tsc --noEmit",
    "check:go": "node scripts/check-go.mjs",
    "check:security": "node scripts/check-security.mjs",
    "lint": "oxlint --type-aware --deny-warnings packages scripts test && knip && node scripts/check-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "coverage": "node --experimental-transform-types --disable-warning=ExperimentalWarning --experimental-test-coverage --test-coverage-include='packages/**' --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=75 --test test/*.test.ts && node scripts/coverage-go.mjs",
    "test:browser": "pnpm run build && node --test test/browser.mjs && node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/host-browser.ts",
    "start": "node dist/server.mjs",
    "dev": "pnpm run build && pnpm start",
    "mcp": "node dist/server.mjs mcp"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.101.0",
    "@agentclientprotocol/codex-acp": "2.7.0",
    "@matapao/vindu": "link:../vindu",
    "celler": "link:../celler",
    "qrcode": "1.5.4",
    "three": "0.186.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "knip": "6.45.1",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "1.65.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
